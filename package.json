{
	"name": "incidentdesk",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts",
		"start": "tsx --env-file=.env src/server.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"contract:generate": "tsx scripts/generate-openapi.ts",
		"contract:check": "tsx scripts/generate-openapi.ts --check",
		"enforce": "tsx scripts/enforce-rules.ts",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:migrate": "tsx --env-file=.env scripts/migrate.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm enforce && pnpm contract:check && pnpm test",
		"prepare": "husky"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@hono/node-server": "^2.1.5",
		"hono": "^4.13.14",
		"pg": "^8.23.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"husky": "^9.1.7",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
