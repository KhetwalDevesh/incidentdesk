PORT=3000
# Matches docker-compose.yml. Start it with `pnpm db:up`, then run `pnpm db:migrate`.
DATABASE_URL=postgres://incidentdesk:incidentdesk@localhost:54329/incidentdesk
# Development only. Format: token:tenantId:userId:role, comma-separated. Roles: viewer, responder, admin.
DEV_API_TOKENS=dev-token-acme:tenant-acme:user-1:responder,dev-token-globex:tenant-globex:user-2:viewer
