PORT=3000
# Matches docker-compose.yml. Start it with `pnpm db:up`, then run `pnpm db:migrate`.
DATABASE_URL=postgres://incidentdesk:incidentdesk@localhost:54329/incidentdesk
# Signs access tokens. Replace for any shared environment: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-me-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=3600
# Encrypts notification webhook URLs at rest. Replace for any shared environment: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LXJlcGxhY2UtbWUtMzItYnl0ZXM=
