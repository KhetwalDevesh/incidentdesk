PORT=3000
# Matches docker-compose.yml. Start it with `pnpm db:up`, then run `pnpm db:migrate`.
DATABASE_URL=postgres://incidentdesk:incidentdesk@localhost:54329/incidentdesk
# Signs access tokens. Replace for any shared environment: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-me-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=3600
# Encrypts notification webhook URLs at rest. Replace for any shared environment: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LXJlcGxhY2UtbWUtMzItYnl0ZXM=
# Alert queue: a real AWS SQS queue of your own, so workers never take each other's messages.
# Create it (and its dead-letter queue) with:
#   pnpm sqs:setup --name incidentdesk-alerts-<you> --region ap-southeast-2
# Credentials come from an AWS CLI profile (aws configure --profile incidentdesk-dev), never this file.
AWS_PROFILE=incidentdesk-dev
# ap-southeast-2: the AWS organisation's policy allows SQS only there.
AWS_REGION=ap-southeast-2
ALERT_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/incidentdesk-alerts-you
# Only for `pnpm test:sqs`: a second queue that no worker reads.
#   pnpm sqs:setup --name incidentdesk-alerts-<you>-test --region ap-southeast-2
TEST_ALERT_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/incidentdesk-alerts-you-test
# Notification queue: one message per Slack delivery. Spec: docs/features/slack-delivery.md
#   pnpm sqs:setup --name incidentdesk-notifications-<you> --region ap-southeast-2
NOTIFICATION_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/incidentdesk-notifications-you
# The only origins webhooks may use, comma-separated. Defaults to https://hooks.slack.com.
# Development adds the local receiver (pnpm dev:receiver).
NOTIFICATION_WEBHOOK_ORIGINS=https://hooks.slack.com,http://127.0.0.1:4000
# Proxies or load balancers in front of the API, whose X-Forwarded-For entries name the client.
# 0 (default) uses the socket address and ignores the header. Spec: docs/features/login-rate-limiting.md
TRUSTED_PROXY_HOPS=0
# AI summary and postmortem drafts, through an OpenAI-compatible API.
# Specs: docs/features/ai-summaries.md, docs/features/ai-postmortems.md
# Without AI_API_KEY no model is called, and drafts are recorded as skipped.
# The free router is used in development and production (a decision recorded in the specs):
#   - free providers may log or train on prompts, so AI_DENY_DATA_COLLECTION must stay false;
#   - the free tier allows 50 requests a day per OpenRouter account (1,000 after buying $10 credits).
# For a paid, no-retention setup instead: AI_MODEL=qwen/qwen3-30b-a3b-instruct-2507 and
# AI_DENY_DATA_COLLECTION=true.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openrouter/free
AI_DENY_DATA_COLLECTION=false
AI_DAILY_DRAFT_CAP=100
